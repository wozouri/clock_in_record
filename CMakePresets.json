{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "description": "面向具有 Visual Studio 开发环境的 Windows。",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "description": "Windows x64 / Qt 5 / MSVC Release，使用本机 Qt 和 vcpkg 依赖。",
      "inherits": "windows-base",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": {
        "type": "allOf",
        "conditions": [
          { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
          { "type": "notEquals", "lhs": "$env{QT_MSVC_ROOT}", "rhs": "" },
          { "type": "notEquals", "lhs": "$env{VCPKG_ROOT}", "rhs": "" }
        ]
      },
      "environment": {
        "PATH": "$env{QT_MSVC_ROOT}/bin;$penv{PATH}",
        "QT_PLUGIN_PATH": "$env{QT_MSVC_ROOT}/plugins"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{QT_MSVC_ROOT}",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "x64-release", "configurePreset": "x64-release" }
  ],
  "testPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "output": { "outputOnFailure": true },
      "environment": {
        "PATH": "${sourceDir}/out/build/${presetName};$env{QT_MSVC_ROOT}/bin;$penv{PATH}",
        "QT_PLUGIN_PATH": "$env{QT_MSVC_ROOT}/plugins"
      }
    }
  ]
}
